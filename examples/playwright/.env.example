# Copy to .env (never commit it). In CI, set these as secrets instead.
BASE_URL=https://your-preview.example.com
MANAGER_EMAIL=manager@example.test
MANAGER_PASSWORD=
MEMBER_EMAIL=member@example.test
MEMBER_PASSWORD=

# Layout check
LIST_PATH=/orders

# Access check
PROTECTED_PATH=/admin/orders
PROTECTED_MARKER=All orders
DENIED_TEXT=You don't have access
PROTECTED_API_PATH=/api/admin/orders

# Event golden
EVENT_DB=app-events
EVENT_STORE=events
